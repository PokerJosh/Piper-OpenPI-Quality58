+@dataclass(frozen=True)
+class _FeedbackSnapshot:
+    values: np.ndarray
+    timestamp: float
+
+    def __post_init__(self) -> None:
+        values = _finite_vector(self.values, 7, "feedback mailbox values").copy()
+        values.setflags(write=False)
+        object.__setattr__(self, "values", values)

+@dataclasses.dataclass(frozen=True)
+class LeRobotPiperJointRTCQuality58DataConfig(DataConfigFactory):
+    """Frozen Quality58 Joint-space H20 data with mask-only window sampling.
+
+    The two source trees are read through ``MaskAwareJointRTCDataset``. The
+    frozen manifest and sample mask are the sole authority for training-window
+    membership; no LeRobot episode sampler is used for this config.
+    """
+
+    repo_id: str = "local/piper_joint_rtc_quality58"
+    manifest_path: str = (
+        "<DATA_QA_ROOT>/joint_rtc_expert_salvage_20260901T161500Z/FINAL_TRAINING_MANIFEST.json"
+    )
+    mask_path: str = (
+        "<DATA_QA_ROOT>/joint_rtc_expert_salvage_20260901T161500Z/FINAL_TRAIN_SAMPLE_MASK.json"
+    )
+    nominal_root: str = "<NOMINAL_DATASET_ROOT>"
+    recovery_root: str = (
+        "<DATASET_ROOT>/"
+        "piper_openpi_v21_recovery_v1_reviewed_clean_11ep"
+    )
+    seed: int | None = None
+    default_prompt: str = "pick and place"
+
+    repack_transforms: tyro.conf.Suppress[_transforms.Group] = dataclasses.field(
+        default=_transforms.Group(
+            inputs=[
+                _transforms.RepackTransform(
+                    {
+                        "images": {
+                            "top": "observation.images.top",
+                            "wrist": "observation.images.wrist",
+                        },
+                        "state": "observation.state",
+                        "actions": "action",
+                        "prompt": "prompt",
+                    }
+                )
+            ]
+        )
+    )
+    action_sequence_keys: Sequence[str] = ("action",)
+
+    @override
+    def create(self, assets_dirs: pathlib.Path, model_config: _model.BaseModelConfig) -> DataConfig:
+        if model_config.action_horizon != 20:
+            raise ValueError("Quality58 Joint RTC config requires action_horizon=20")
+        if model_config.action_dim != 32:
+            raise ValueError("Quality58 Joint RTC config requires latent action_dim=32")
+        if model_config.training_rtc_action_dim != 7:
+            raise ValueError("Quality58 Joint RTC config requires physical training_rtc_action_dim=7")
+
+        data_transforms = _transforms.Group(
+            inputs=[piper_policy.PiperInputs()],
+            outputs=[piper_policy.PiperOutputs()],
+        )
+        # J1-J6 are deltas relative to the current state; G remains absolute.
+        delta_action_mask = _transforms.make_bool_mask(6, -1)
+        data_transforms = data_transforms.push(
+            inputs=[_transforms.DeltaActions(delta_action_mask)],
+            outputs=[_transforms.AbsoluteActions(delta_action_mask)],
+        )
+        model_transforms = ModelTransformFactory(default_prompt=self.default_prompt)(model_config)
+
+        return dataclasses.replace(
+            self.create_base_config(assets_dirs, model_config),
+            repack_transforms=self.repack_transforms,
+            data_transforms=data_transforms,
+            model_transforms=model_transforms,
+            action_sequence_keys=self.action_sequence_keys,
+            mask_aware_manifest_path=self.manifest_path,
+            mask_aware_mask_path=self.mask_path,
+            mask_aware_nominal_root=self.nominal_root,
+            mask_aware_recovery_root=self.recovery_root,
+            mask_aware_seed=self.seed,
+            mask_aware_prompt=self.default_prompt,
+        )
+

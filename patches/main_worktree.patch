+    prompt_from_task: bool = False
+
+    # Only used for RLDS data loader (ie currently only used for DROID).
+    rlds_data_dir: str | None = None
+    # Action space for DROID dataset.
+    action_space: droid_rlds_dataset.DroidActionSpace | None = None
+    # List of datasets to sample from: name, version, weight, and optionally filter_dict_path
+    datasets: Sequence[droid_rlds_dataset.RLDSDataset] = ()
+
+    # Optional frozen-window dataset inputs. When set, create_torch_dataset uses the
+    # read-only mask-aware adapter instead of LeRobot's episode sampler. These fields
+    # are intentionally explicit so ordinary LeRobot configs keep their old path.
+    mask_aware_manifest_path: str | None = None
+    mask_aware_mask_path: str | None = None
+    mask_aware_nominal_root: str | None = None
+    mask_aware_recovery_root: str | None = None
